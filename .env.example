# Configurações do MySQL
DB_NAME=database_dev
DB_USER=admin
DB_PASS=admin
DB_ROOT_PASS=root_password
DB_PORT=3307

# Configurações do DBeaver Web (CloudBeaver)
CB_PORT=8978

# Configurações do Mailpit (captura os e-mails enviados em desenvolvimento)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# E-mail da aplicação (redefinição de senha)
# Deixe este bloco comentado para usar o Mailpit. Para enviar pelo Gmail,
# descomente e preencha MAIL_USERNAME e MAIL_PASSWORD (senha de app, sem espaços e sem aspas).
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS_REQUIRED=true
# MAIL_USERNAME=seu.email@gmail.com
# MAIL_PASSWORD=suasenhadeapp

# Login com o Google (gratuito). Sem estas variáveis, o botão "Entrar com Google" não aparece.
# Crie as credenciais em https://console.cloud.google.com/apis/credentials:
# "Criar credenciais" > "ID do cliente OAuth" > tipo "Aplicativo da Web".
#
# URIs de redirecionamento autorizados: o Google exige o endereço EXATO, inclusive a porta.
# Cadastre uma linha para cada porta usada pela equipe (o http:// é aceito para localhost):
#   http://localhost:8082/login/oauth2/code/google
#   http://localhost:8090/login/oauth2/code/google   <- ex.: quem usa SERVER_PORT=8090
# O app monta esse endereço sozinho a partir da porta em que está rodando; basta liberá-lo no Google.
# A alteração pode levar alguns minutos para valer.
#
# Cuidados:
# - localhost e 127.0.0.1 são endereços diferentes para o Google: acesse pelo endereço cadastrado.
# - Erro 400 "redirect_uri_mismatch": a porta não está cadastrada. A mensagem mostra o endereço
#   que o app pediu; copie-o para a lista de URIs.
# - Com a tela de consentimento em modo "Teste", só entram os e-mails listados em
#   "Público-alvo" > "Usuários de teste" (até 100). Adicione os e-mails de cada desenvolvedor.
# - A equipe pode usar o mesmo cliente (mesmo ID e secret). Envie o secret por um canal privado,
#   nunca pelo git. Outra opção é cada desenvolvedor criar o próprio cliente OAuth.
# GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=seu-client-secret

# Configurações da Aplicação (Spring Boot)
SERVER_PORT=8082

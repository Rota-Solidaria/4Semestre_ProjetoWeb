<#import "../layout/main.ftlh" as main>

<@main.layout title="Página Não Encontrada - Rota Solidária" css="/css/index.css">
  <main class="container">
    <div class="panel" style="max-width:600px;margin:64px auto;text-align:center;">
      <span class="kicker">Erro 404</span>
      <h1 style="font:800 clamp(1.8rem,3.4vw,2.2rem)/1.1 Archivo,sans-serif;margin:10px 0;">Página não encontrada</h1>
      <p class="muted">A página que você procura não existe ou foi removida.</p>
      <div style="margin-top:24px;">
        <a class="btn btn-primary" href="/">Voltar ao início</a>
      </div>
    </div>
  </main>
</@main.layout>

<!doctype html>
<html lang="pt-BR">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Inscrição Confirmada</title>
  <link rel="icon" href="assets/favicon.ico">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800&family=IBM+Plex+Mono:wght@500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet">
  <link rel="stylesheet" href="/css/sucesso.css">
</head>

<body>
  <header class="site-header">
    <div class="container header-inner">
      <a class="logo" href="/">
        <span class="logo-mark"><span class="logo-dot"></span></span>
        <span class="logo-text"><span class="brand">Rota</span> Solidária</span>
      </a>
      <nav class="nav">
        <a href="/">Início</a>
        <a href="/campanhas">Campanhas</a>
        <a href="/educativo">Saiba Mais</a>
      </nav>
      <div class="header-actions">
        <a class="icon-btn" href="#acessibilidade" aria-label="Acessibilidade"><span class="icon">accessibility_new</span></a>
        <a class="profile-chip" href="/login"><span class="avatar">RS</span>Perfil</a>
      </div>
    </div>
    <div class="mobile-nav container">
      <a href="/">Início</a>
      <a href="/campanhas">Campanhas</a>
      <a href="/educativo">Saiba Mais</a>
      <a href="/login">Perfil</a>
    </div>
  </header>

  <main class="container">
    <div class="success-wrap">
      <div class="panel success-panel">
        <span class="success-icon"><span class="icon">check_circle</span></span>
        <h1>Inscrição confirmada!</h1>
        <p>Muito obrigado por se inscrever. Sua atitude salva vidas.</p>

        <div class="summary-box">
          <div class="row"><span>Campanha</span><strong>Campanha Mês Amarelo</strong></div>
          <div class="divider"></div>
          <div class="row"><span>Data e saída</span><strong>11 de Maio · 05:00h</strong></div>
          <div class="divider"></div>
          <div class="row"><span>Local</span><strong>Colsan — Posto de Coleta Sorocaba</strong></div>
        </div>

        <div class="warn-box">
          <div class="warn-head"><span class="icon">error</span>Preparo para o dia</div>
          <ul>
            <li>· Documento com foto original</li>
            <li>· Alimentação leve até 4 horas antes</li>
            <li>· 6 horas de sono e boa hidratação</li>
          </ul>
        </div>

        <p style="color:var(--text2);margin:0 0 18px">O organizador da campanha entrará em contato com você pelo WhatsApp informado em até 48 horas.</p>

        <div class="success-actions">
          <a class="btn btn-primary btn-lg" href="/"><span class="icon">home</span>Voltar para o início</a>
          <a class="btn btn-secondary btn-lg" href="/educativo">Preparo para doação</a>
        </div>
      </div>
    </div>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <span class="footer-brand"><span class="icon">favorite</span><strong>Rota Solidária</strong> · 2026</span>
      <span>Projeto de Extensão · Angatuba e Região</span>
    </div>
  </footer>
</body>

</html>